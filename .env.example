# Backend environment — copy to .env and adjust for your deployment.
PORT=8765
NODE_ENV=development
# MongoDB connection string (local service: mongodb://127.0.0.1:27017/taxi)
MONGODB_URI=mongodb://127.0.0.1:27017/taxi
# Frontend origin — used for CORS + socket.io origin checks. Set to your deployed web URL.
CLIENT_URL=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_NAME=rt

# Auth
# OTP codes are FIXED to 000000 until a messaging service is connected
# (generateVerificationCode in src/services/message.service.ts).
